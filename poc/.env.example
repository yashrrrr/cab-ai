# RFC Lifecycle PoC — Environment Configuration

# OpenAI API Key (Required for AI CAB Deliberation)
# ⚠️ IMPORTANT: GitHub Models was retired on July 30, 2026
# You MUST use an OpenAI API key instead
#
# Get your API key from: https://platform.openai.com/api-keys
# 1. Sign in to OpenAI Platform
# 2. Click "Create new secret key"
# 3. Copy the key (starts with sk-proj- or sk-)
# 4. Paste it below (replace YOUR_OPENAI_API_KEY_HERE)
OPENAI_API_KEY="YOUR_OPENAI_API_KEY_HERE"

# Backend Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend Settings
REACT_APP_API_BASE=http://localhost:8000

# Database (PoC uses SQLite)
DATABASE_PATH=./backend/rfc_poc.db

# LLM Gateway (Required for CAB Readiness Agent — a separate feature from
# AI CAB Deliberation above). Fronts real Claude models via an internal
# LiteLLM proxy. Real values live in a gitignored .env.llm file at the repo
# root (poc/backend/llm_gateway.py reads that file as a fallback if these
# env vars aren't set, so no secret needs duplicating here).
LLM_GATEWAY_BASE_URL=
LLM_GATEWAY_API_KEY=
LLM_GATEWAY_PEM_PATH=
LLM_GATEWAY_PEM_MODE=ca_bundle
LLM_GATEWAY_MODEL=
